# Site URL (used for canonical URLs, OG tags, schema.org)
# Local dev: leave unset (will default to https://lukegrady1.github.io/gregs-cuts)
NEXT_PUBLIC_SITE_URL=https://lukegrady1.github.io/gregs-cuts

# Base path for static export — only set in production builds for GH Pages.
# Leave unset for local dev so the site serves from /.
# NEXT_PUBLIC_BASE_PATH=/gregs-cuts

# GoHighLevel inbound webhook for the contact form (called from the browser).
NEXT_PUBLIC_GHL_CONTACT_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/REPLACE_ME

# Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
